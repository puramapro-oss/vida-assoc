{
  "expo": {
    "name": "Sangha",
    "slug": "vida-assoc",
    "scheme": "vida",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.purama.vidaassoc",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Sangha utilise la caméra pour photographier tes preuves de mission (déchets ramassés, arbre planté…).",
        "NSPhotoLibraryUsageDescription": "Sangha accède à ta galerie pour charger une photo comme preuve de mission.",
        "NSLocationWhenInUseUsageDescription": "Sangha horodate la géolocalisation de ta mission pour valider l’impact réel.",
        "NSUserTrackingUsageDescription": "Ces données nous aident à te proposer des missions près de chez toi — jamais revendues.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:vida-assoc.purama.dev"]
    },
    "android": {
      "package": "dev.purama.vidaassoc",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "vida-assoc.purama.dev" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sangha accède à ta galerie pour charger une photo comme preuve de mission.",
          "cameraPermission": "Sangha utilise la caméra pour photographier tes preuves de mission."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sangha horodate ta position lors des missions pour valider l’impact réel."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "puramapro-oss"
  }
}
