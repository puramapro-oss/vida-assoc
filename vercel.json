{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/unlock-primes",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/reset-streak",
      "schedule": "1 0 * * *"
    },
    {
      "path": "/api/cron/karma-weekly",
      "schedule": "59 23 * * 0"
    },
    {
      "path": "/api/cron/account-deletion",
      "schedule": "0 3 * * *"
    }
  ],
  "installCommand": "git config --global url.\"https://${SMARANA_GIT_TOKEN}@github.com/\".insteadOf \"ssh://git@github.com/\" && npm install",
  "git": {
    "deploymentEnabled": {
      "fix/vida-assoc-auth-mission-integrity-20261122": false
    }
  }
}
